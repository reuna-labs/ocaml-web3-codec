# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Bech32 and Bech32m for web3 address encodings"
description: """
BIP-173 Bech32 and BIP-350 Bech32m, without the full web3-codec dependency
closure. Depends on nothing: the checksum is integer arithmetic and the
charset is a string, so this links into a MirageOS/Solo5 unikernel and needs
no bignum.

The 90-character cap is BIP-173's and remains the default, but it is a
parameter rather than a constant -- the Cosmos SDK spells addresses in Bech32
and does not enforce it."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-web3-codec"
bug-reports: "https://github.com/reuna-labs/ocaml-web3-codec/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-web3-codec.git"
