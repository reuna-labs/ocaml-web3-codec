# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Serialization formats shared across blockchain protocols"
description: """
Byte-level codecs used by more than one chain: Ethereum ABI, RLP, SCALE,
Borsh, base58, bech32, SS58 and the CRC variants those formats rely on,
plus the multiformats family -- unsigned varint, multibase (with base16,
base32 and base64), multicodec, multihash, CID, multiaddr, multikey and
multistream-select framing."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-web3-codec"
bug-reports: "https://github.com/reuna-labs/ocaml-web3-codec/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "zarith" {>= "1.12"}
  "digestif" {>= "1.4.0"}
  "evm-abi" {>= "0.1.0"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-web3-codec.git"

pin-depends: [
  # evm-abi lives in a separate private repository, so opam cannot find it
  # without being told where. evm-types is named too: pin-depends are not
  # applied transitively, so pinning evm-abi does not pin what evm-abi's own
  # opam file depends on. Regenerating this file from dune-project drops the
  # block -- dune cannot express pin-depends. Re-add it if you do.
  [
    "evm-abi.0.2.0~alpha1"
    "git+https://github.com/reuna-labs/ocaml-evm.git#main"
  ]
  [
    "evm-types.0.2.0~alpha1"
    "git+https://github.com/reuna-labs/ocaml-evm.git#main"
  ]
]
